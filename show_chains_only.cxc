# ChimeraX commands to show only chain structure (no surface)

# Hide all surfaces
surface close

# Show cartoon representation for all chains with default settings
cartoon style modeHelix default modeStrand default
cartoon

# Optional: Color each chain differently for easy visualization
color /A cornflower blue
color /B light blue
color /C salmon
color /D pink
color /E gold
color /F yellow

# Optional: Set background to white for better visibility
set bgColor white

# Fit model in view
view
